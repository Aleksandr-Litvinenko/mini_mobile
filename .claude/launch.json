{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "moba-host",
      "runtimeExecutable": "Builds/MiniMoba.app/Contents/MacOS/Mini Moba",
      "runtimeArgs": ["-host"],
      "port": 7777
    },
    {
      "name": "moba-host-headless",
      "runtimeExecutable": "Builds/MiniMoba.app/Contents/MacOS/Mini Moba",
      "runtimeArgs": ["-batchmode", "-nographics", "-host", "-logFile", "/tmp/moba_host.log"],
      "port": 7777
    },
    {
      "name": "moba-client-localhost",
      "runtimeExecutable": "Builds/MiniMoba.app/Contents/MacOS/Mini Moba",
      "runtimeArgs": ["-join", "127.0.0.1"]
    },
    {
      "name": "moba-training",
      "runtimeExecutable": "Builds/MiniMoba.app/Contents/MacOS/Mini Moba",
      "runtimeArgs": ["-training"]
    }
  ]
}
